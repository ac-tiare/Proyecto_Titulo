NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://contigo:change-me-local-only@localhost:5432/contigo?schema=public
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_DAYS=14
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Usa SMTP_PASSWORD o su alias SMTP_PASS.
SMTP_PASSWORD=
SMTP_PASS=
SMTP_FROM=
# Usa PUBLIC_APP_URL o su alias FRONTEND_URL.
PUBLIC_APP_URL=
FRONTEND_URL=http://localhost:8080
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
WEB_ORIGINS=http://localhost:8080,http://localhost:3000
NATIVE_ORIGINS=capacitor://localhost,http://localhost
TRUST_PROXY=false
LOG_LEVEL=info
