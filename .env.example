# Copy this file to .env and replace every example secret before starting Docker.
CONTIGO_PORT=8080

POSTGRES_DB=contigo
POSTGRES_USER=contigo
POSTGRES_PASSWORD=replace-with-a-long-random-local-secret
DATABASE_URL=postgresql://contigo:replace-with-a-long-random-local-secret@database:5432/contigo?schema=public

NODE_ENV=production
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_DAYS=14
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
WEB_ORIGINS=http://localhost:8080
NATIVE_ORIGINS=capacitor://localhost,http://localhost
TRUST_PROXY=true
LOG_LEVEL=info
